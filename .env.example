# OpenRouter（默认）
FACERECALL_API_BASE=https://openrouter.ai/api/v1
FACERECALL_API_KEY=sk-or-v1-xxx

# 模型（OpenRouter 格式：provider/model）
FACERECALL_LLM_MODEL=openai/gpt-4o
FACERECALL_IMAGE_MODEL=openai/gpt-5.4-image-2

# 图像生成超时（秒）。openai/gpt-5.4-image-2 单张实测 ~165s，留 5 分钟余量。
# FACERECALL_HTTP_TIMEOUT=300

# 国内代理（直连时填）
# HTTPS_PROXY=http://127.0.0.1:7890
